generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccessRole {
  EMPLOYEE
  MANAGER
  HR
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum OnboardingReviewStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum RunStatus {
  STARTED
  SUCCEEDED
  REJECTED
  FAILED
}

enum SecurityEventType {
  AUTHORIZATION_DENIED
  UNSAFE_REQUEST_REJECTED
}

enum SecuritySeverity {
  LOW
  MEDIUM
  HIGH
}

enum ProcessedEventStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Employee {
  id             String                   @id @default(cuid())
  employeeCode   String                   @unique @map("employee_code")
  fullName       String                   @map("full_name")
  email          String                   @unique
  department     String
  jobTitle       String                   @map("job_title")
  accessRole     AccessRole               @default(EMPLOYEE) @map("access_role")
  status         EmployeeStatus           @default(ACTIVE)
  managerId      String?                  @map("manager_id")
  manager        Employee?                @relation("EmployeeManager", fields: [managerId], references: [id])
  directReports  Employee[]               @relation("EmployeeManager")
  reviewPeriods  OnboardingReviewPeriod[]
  agentRuns      AgentRun[]               @relation("ActorEmployee")
  securityEvents SecurityEvent[]
  leaveBalances  LeaveBalance[]
  leaveRequests  LeaveRequest[]
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")

  @@index([managerId])
  @@map("employees")
}

model LeavePolicy {
  id                            String         @id @default(cuid())
  code                          String         @unique
  name                          String
  annualAllowanceDays           Int            @map("annual_allowance_days")
  workingDays                   String         @map("working_days")
  minimumNoticeWorkingDays      Int            @map("minimum_notice_working_days")
  maximumConsecutiveWorkingDays Int            @map("maximum_consecutive_working_days")
  excludesHolidays              Boolean        @default(true) @map("excludes_holidays")
  balances                      LeaveBalance[]
  requests                      LeaveRequest[]
  createdAt                     DateTime       @default(now()) @map("created_at")
  updatedAt                     DateTime       @updatedAt @map("updated_at")

  @@map("leave_policies")
}

model LeaveBalance {
  id            String      @id @default(cuid())
  employeeId    String      @map("employee_id")
  leavePolicyId String      @map("leave_policy_id")
  year          Int
  allocatedDays Int         @map("allocated_days")
  usedDays      Int         @default(0) @map("used_days")
  pendingDays   Int         @default(0) @map("pending_days")
  employee      Employee    @relation(fields: [employeeId], references: [id])
  leavePolicy   LeavePolicy @relation(fields: [leavePolicyId], references: [id])
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@unique([employeeId, leavePolicyId, year])
  @@index([employeeId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id                   String             @id @default(cuid())
  employeeId           String             @map("employee_id")
  leavePolicyId        String             @map("leave_policy_id")
  startDate            DateTime           @map("start_date") @db.Date
  endDate              DateTime           @map("end_date") @db.Date
  requestedWorkingDays Int                @map("requested_working_days")
  status               LeaveRequestStatus @default(PENDING)
  employee             Employee           @relation(fields: [employeeId], references: [id])
  leavePolicy          LeavePolicy        @relation(fields: [leavePolicyId], references: [id])
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  @@index([employeeId, startDate, endDate])
  @@map("leave_requests")
}

model OnboardingReviewPeriod {
  id         String                 @id @default(cuid())
  employeeId String                 @map("employee_id")
  startDate  DateTime               @map("start_date") @db.Date
  endDate    DateTime               @map("end_date") @db.Date
  status     OnboardingReviewStatus @default(ACTIVE)
  employee   Employee               @relation(fields: [employeeId], references: [id])
  createdAt  DateTime               @default(now()) @map("created_at")
  updatedAt  DateTime               @updatedAt @map("updated_at")

  @@index([employeeId, status, endDate])
  @@map("onboarding_review_periods")
}

model AgentRun {
  id                String          @id @default(cuid())
  runId             String          @unique @map("run_id")
  correlationId     String          @map("correlation_id")
  threadId          String?         @map("thread_id")
  triggerType       String          @map("trigger_type")
  intent            String?
  status            RunStatus       @default(STARTED)
  actorEmployeeCode String?         @map("actor_employee_code")
  actorEmployee     Employee?       @relation("ActorEmployee", fields: [actorEmployeeCode], references: [employeeCode])
  requestSummary    String?         @map("request_summary")
  resultSummary     String?         @map("result_summary")
  startedAt         DateTime        @default(now()) @map("started_at")
  completedAt       DateTime?       @map("completed_at")
  steps             AgentRunStep[]
  securityEvents    SecurityEvent[]

  @@index([correlationId])
  @@index([actorEmployeeCode])
  @@map("agent_runs")
}

model AgentRunStep {
  id          String    @id @default(cuid())
  agentRunId  String    @map("agent_run_id")
  stepName    String    @map("step_name")
  status      String
  outcomeCode String?   @map("outcome_code")
  inputData   String?   @map("input_data")
  outputData  String?   @map("output_data")
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  agentRun    AgentRun  @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@index([agentRunId, startedAt])
  @@map("agent_run_steps")
}

model SecurityEvent {
  id                String            @id @default(cuid())
  agentRunId        String?           @map("agent_run_id")
  correlationId     String?           @map("correlation_id")
  actorEmployeeCode String?           @map("actor_employee_code")
  eventType         SecurityEventType @map("event_type")
  severity          SecuritySeverity
  details           String?
  createdAt         DateTime          @default(now()) @map("created_at")
  agentRun          AgentRun?         @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  actorEmployee     Employee?         @relation(fields: [actorEmployeeCode], references: [employeeCode])

  @@index([correlationId, createdAt])
  @@index([eventType, createdAt])
  @@map("security_events")
}

model ProcessedEvent {
  eventId       String               @id @map("event_id")
  type          String
  payloadHash   String               @map("payload_hash")
  status        ProcessedEventStatus @default(PROCESSING)
  attempt       Int                  @default(1)
  correlationId String               @map("correlation_id")
  runId         String?              @map("run_id")
  threadId      String?              @map("thread_id")
  errorCode     String?              @map("error_code")
  receivedAt    DateTime             @default(now()) @map("received_at")
  completedAt   DateTime?            @map("completed_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  @@index([status, updatedAt])
  @@index([correlationId])
  @@map("processed_events")
}

model KnowledgeDocument {
  id                    String           @id
  title                 String
  originalFileName      String           @map("original_file_name")
  mediaType             String           @map("media_type")
  contentHash           String           @map("content_hash")
  activeIndexVersion    Int              @default(0) @map("active_index_version")
  createdByEmployeeCode String           @map("created_by_employee_code")
  chunks                KnowledgeChunk[]
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  @@index([contentHash])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id              String   @id
  documentId      String   @map("document_id")
  indexVersion    Int      @map("index_version")
  embeddingModel  String   @map("embedding_model")
  chunkingVersion String   @map("chunking_version")
  chunkIndex      Int      @map("chunk_index")
  pageNumber      Int?     @map("page_number")
  content         String
  embedding       Unsupported("vector(1536)")
  document        KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([documentId, indexVersion, chunkIndex])
  @@index([documentId, indexVersion])
  @@map("knowledge_chunks")
}
